# Hermes Command Center configuration
# Copy to apps/eve/.env.local. Never commit real values.

# Public identity
NEXT_PUBLIC_AGENT_NAME="Hermes"
NEXT_PUBLIC_OWNER_NAME="Rob"
NEXT_PUBLIC_APP_NAME="Hermes Command Center"

# Runtime mode. `bridge` is required for real Mac-mini execution.
HERMES_EXECUTION_MODE="bridge"
# URL is server-side only. Prefer a private Tailscale-accessible bridge.
HERMES_BRIDGE_URL="http://100.77.85.60:9120"
HERMES_BRIDGE_SHARED_SECRET=""

# Convex is the durable state layer. Tokens remain server-side.
NEXT_PUBLIC_CONVEX_URL=""
CONVEX_DEPLOYMENT=""

# Netlify/public origin
NEXT_PUBLIC_APP_ORIGIN=""

# Optional web push public key; private key remains server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Subscription-only rule: do not add provider API keys here.
# Claude/Codex/Gemini authentication stays on the Mac mini Hermes runtime.
